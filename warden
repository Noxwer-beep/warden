#!/usr/bin/env python3
"""Run Warden from the checkout:  ./warden check

The package lives in src/ so this launcher can be called `warden` — a file and a
folder of the same name cannot share a directory.
"""

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "src"))

try:
    from warden.cli import main
except ModuleNotFoundError as exc:  # pragma: no cover - environment problem
    if "rich" in str(exc):
        sys.exit(
            "Warden needs rich for its table output:\n"
            "    pip install rich\n"
            "or install the package:  pip install -e '.[cli,ui]'"
        )
    raise

if __name__ == "__main__":
    raise SystemExit(main())
